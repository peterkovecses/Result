@Host = http://localhost:5110

### Get a book
# Returns the book DTO directly.
GET {{Host}}/api/catalog/books/9780132350884

### Get a missing book
# Returns a 404 ProblemDetails response via direct Error mapping.
GET {{Host}}/api/catalog/books/9780000000000

### Search the catalog
GET {{Host}}/api/catalog/books?term=Clean&page=1&pageSize=10

### Search with invalid paging
# Returns ValidationProblemDetails populated from validation metadata.
GET {{Host}}/api/catalog/books?term=Clean&page=0&pageSize=10

### Get a complete Result envelope for an internal client
GET {{Host}}/internal/books/9780132350884

### Add a book
# Returns 201 Created with a Location header.
POST {{Host}}/api/catalog/books
Content-Type: application/json

{
  "isbn": "9780000000001",
  "title": "A Practical Guide to APIs",
  "author": "Alex Example",
  "price": 28.50,
  "initialStock": 10
}

### Change a book price
PUT {{Host}}/api/catalog/books/9780132350884/price
Content-Type: application/json

{
  "newPrice": 35.00
}

### Restock books atomically
POST {{Host}}/api/catalog/books/restock
Content-Type: application/json

{
  "items": [
    { "isbn": "9780132350884", "quantity": 3 },
    { "isbn": "9780134494166", "quantity": 2 }
  ]
}

### Place an order
# Set the caller identity through the host's current-user header implementation.
POST {{Host}}/api/orders
X-Customer-Id: customer-123
Content-Type: application/json

{
  "lines": [
    { "isbn": "9780132350884", "quantity": 1 }
  ]
}

### Place an order with a declined payment
# First add a book priced above the fake gateway's per-order limit, then order it.
POST {{Host}}/api/catalog/books
Content-Type: application/json

{
  "isbn": "9780000000002",
  "title": "The Costly Test",
  "author": "Alex Example",
  "price": 1200.00,
  "initialStock": 10
}

POST {{Host}}/api/orders
X-Customer-Id: customer-123
Content-Type: application/json

{
  "lines": [
    { "isbn": "9780000000002", "quantity": 1 }
  ]
}

### Get an order
# Replace the example id with the id returned by Place an order.
GET {{Host}}/api/orders/00000000-0000-0000-0000-000000000000
X-Customer-Id: customer-123

### Get an order summary
GET {{Host}}/api/orders/00000000-0000-0000-0000-000000000000/summary
X-Customer-Id: customer-123

### Cancel an order
POST {{Host}}/api/orders/00000000-0000-0000-0000-000000000000/cancel
X-Customer-Id: customer-123
