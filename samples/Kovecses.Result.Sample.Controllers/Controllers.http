@Host = http://localhost:5106

### Get a book
# Returns the book DTO, or ProblemDetails when the ISBN is unknown.
GET {{Host}}/books/9780132350884

### Search the catalog
GET {{Host}}/books?term=clean&page=1&pageSize=10

### Add a book
# Returns 201 Created with a Location header.
POST {{Host}}/books
Content-Type: application/json

{
  "isbn": "9780000000001",
  "title": "A Sample Book",
  "author": "Sample Author",
  "price": 12.50,
  "initialStock": 4
}

### Invalid book fields
# Returns 400 ValidationProblemDetails with field-level errors.
POST {{Host}}/books
Content-Type: application/json

{
  "isbn": "",
  "title": "",
  "author": "",
  "price": 0,
  "initialStock": -1
}

### Change a book price
PUT {{Host}}/books/9780132350884/price
Content-Type: application/json

{
  "newPrice": 45
}

### Restock a book
# Returns 204 and an X-Restocked-Books response header.
POST {{Host}}/books/restock
Content-Type: application/json

{
  "items": [
    { "isbn": "9780132350884", "quantity": 3 }
  ]
}

### Retire a book
DELETE {{Host}}/books/9780134494166

### Place an order
# Set X-Customer-Id to select the current customer.
POST {{Host}}/orders
X-Customer-Id: alice
Content-Type: application/json

{
  "lines": [
    { "isbn": "9780132350884", "quantity": 1 }
  ]
}

### Read an order (replace the id with the one from the response Location header)
GET {{Host}}/orders/00000000-0000-0000-0000-000000000000
X-Customer-Id: alice

### Read an order through the internal typed-client route
# Returns the full Result<OrderDto> response.
GET {{Host}}/internal/orders/00000000-0000-0000-0000-000000000000
X-Customer-Id: alice
